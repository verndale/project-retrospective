#!/usr/bin/env sh
pnpm run lint:staged || exit 1

node scripts/wiki/pre-commit-journal.cjs || echo "warning: wiki journal reminder failed open" >&2

# Keep the committed knowledge graph in sync with current repo state. The build is
# deterministic and fast. Do not rebuild from unstaged input: that would stage generated
# bytes describing work outside this commit. Build and staging failures remain advisory;
# `pnpm graph:check` in CI is the blocking, check-only freshness backstop. Skipped in CI.
if [ -z "$CI" ]; then
  unstaged_inputs="$(
    git status --porcelain --untracked-files=all -- \
      AGENTS.md CLAUDE.md CONTRIBUTING.md README.md skills scripts wiki \
      ':(exclude)scripts/graph/data/graph.json' \
      ':(exclude)wiki/connections.md' \
      ':(exclude)wiki/connections/**' |
    awk 'substr($0,1,2) == "??" || substr($0,2,1) != " " { print }'
  )"
  if [ -n "$unstaged_inputs" ]; then
    echo "warning: unstaged graph inputs detected; knowledge graph rebuild skipped to avoid staging unrelated generated data" >&2
  elif node scripts/graph/build-graph.cjs >/dev/null 2>&1; then
    # `|| true` keeps the promise above: git add is the hook's last command, so its exit
    # status would otherwise become the hook's and a locked index would abort the commit.
    git add scripts/graph/data/graph.json wiki/connections.md wiki/connections || true
  else
    echo "warning: knowledge graph rebuild failed; committed graph.json may be stale (run pnpm graph:build)" >&2
  fi
fi
